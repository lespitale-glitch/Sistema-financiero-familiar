# ============================================================================
# FINANZAS FAMILIARES - Configuracion de entorno
# Copiar a .env y completar. El sistema arranca sin todo configurado:
# las funciones cuyo servicio falte quedan deshabilitadas con un aviso claro.
# ============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
TZ=America/Argentina/Buenos_Aires
LOG_LEVEL=info
APP_NAME=Finanzas Familiares
# Moneda por defecto (codigo ISO 4217) y locale para formateo
CURRENCY=ARS
LOCALE=es-AR
# Chat familiar donde se envian resumenes y alertas (ID numerico, puede ser grupo -100...)
FAMILY_CHAT_ID=
# Token para los endpoints privados /api/* (generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_TOKEN=

# --- Telegram ----------------------------------------------------------------
# Crear bot con @BotFather. Sin token el bot queda deshabilitado (la API sigue activa).
TELEGRAM_BOT_TOKEN=
# polling (desarrollo) | webhook (produccion detras de HTTPS)
TELEGRAM_MODE=polling
# Requerido en modo webhook: URL publica HTTPS, ej. https://mi-app.onrender.com
PUBLIC_URL=
# Secreto del webhook (OBLIGATORIO en modo webhook). Telegram lo envia en el header.
TELEGRAM_WEBHOOK_SECRET=
# Chat IDs autorizados extra, separados por coma (ademas de los usuarios de FAMILY_MEMBERS)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Miembros de la familia --------------------------------------------------
# Formato: nombre|rol|telegram_id|email ; separar con ';' o saltos de linea.
# Roles: husband, wife, daughter, son, other. Todos los campos salvo nombre son opcionales.
# Ejemplo:
# FAMILY_MEMBERS=Sebastian|husband|111111111|sebastian@example.com;Ana|wife|222222222|ana@example.com;Lucia|daughter|333333333|

FAMILY_MEMBERS=

# --- Base de datos -----------------------------------------------------------
# sqlite (default, archivo local persistente) | supabase (Postgres en la nube)
DB_DRIVER=sqlite
SQLITE_PATH=./data/finanzas.sqlite
# Solo si DB_DRIVER=supabase
SUPABASE_URL=
# Usar la service_role key: el backend accede a PostgREST. NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, si el esquema no es public
SUPABASE_SCHEMA=public

# --- Gemini (OCR de facturas, transcripcion de voz y parsing asistido) -------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Limite de descarga de archivos de Telegram (bytes)
MAX_UPLOAD_BYTES=10485760

# --- Alertas y resumenes -----------------------------------------------------
# Umbrales de presupuesto que disparan alerta (porcentaje del limite)
BUDGET_ALERT_THRESHOLDS=80,100
ALERTS_ENABLED=true
# Hora local (HH:MM) del resumen diario. Vaciar para deshabilitar.
DAILY_SUMMARY_AT=21:00
# 0=domingo ... 6=sabado. Hora local del resumen semanal.
WEEKLY_SUMMARY_DAY=1
WEEKLY_SUMMARY_AT=09:00
# Resumen mensual el dia 1 a esta hora local.
MONTHLY_SUMMARY_AT=08:00
# Enviar alertas tambien al chat privado del autor (ademas del chat familiar)
ALERT_AUTHOR_DM=true
# Zona horaria usada para periodos
REPORT_TIMEZONE=America/Argentina/Buenos_Aires

# --- Email ingestion ---------------------------------------------------------
# Token para POST /api/email/inbound (SendGrid/Mailgun/Cloudflare/forwarder propio)
EMAIL_INGEST_TOKEN=
# Buzon IMAP opcional. Si se completa, se consulta periodicamente.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=300
# Direccion a la que se reenvian las facturas (solo informativa)
EMAIL_FORWARD_ADDRESS=

# --- HTTP API ----------------------------------------------------------------
# Token de acceso a endpoints /api/*; si esta vacio, se reutiliza API_TOKEN
# Rate limit simple en memoria para endpoints de ingesta
INGEST_RATE_LIMIT_PER_MINUTE=30
# Proxies confiables para la IP real del cliente (X-Forwarded-For).
# 1 = un proxy delante (Render, Nginx). false = expuesto directo. Nunca "true".
TRUST_PROXY=1
